
#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>
#include <stdint.h>
#include <stdio.h>
#include <math.h>

#define HEATER PB0
#define FAN_PWM PB1
#define RELAY_ACTIVE_LOW 1

#define R_SERIE 10000.0
#define R_NOMINAL 10000.0
#define TEMP_NOMINAL 25.0
#define BETA 3950.0

int punto_medio = 22;
int rango_min;
int rango_max;
int fan_bajo_max;
int fan_medio_max;

uint8_t calefactor = 0;
uint8_t velocidad_ventilador = 0;

const char *accion_actual;

void uart_init(void)
{
    UBRR0H = 0;
    UBRR0L = 103;
    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void uart_putchar(char c)
{
    while (!(UCSR0A & (1 << UDRE0)));
    UDR0 = c;
}

void uart_print(const char *texto)
{
    while (*texto)
    {
        uart_putchar(*texto);
        texto++;
    }
}

void adc_init(void)
{
    ADMUX = (1 << REFS0);
    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);
}

uint16_t adc_read(uint8_t canal)
{
    ADMUX = (ADMUX & 0xF0) | (canal & 0x0F);
    ADCSRA |= (1 << ADSC);

    while (ADCSRA & (1 << ADSC));

    return ADC;
}

float leer_temperatura(void)
{
    uint16_t adc = adc_read(0);

    if (adc == 0)
        adc = 1;

    if (adc >= 1023)
        adc = 1022;

    float resistencia = R_SERIE * ((1023.0 / adc) - 1.0);
    float temperatura = resistencia / R_NOMINAL;

    temperatura = log(temperatura);
    temperatura /= BETA;
    temperatura += 1.0 / (TEMP_NOMINAL + 273.15);
    temperatura = 1.0 / temperatura;
    temperatura -= 273.15;

    return temperatura;
}

void pwm_init(void)
{
    DDRB |= (1 << FAN_PWM);

    TCCR1A = (1 << COM1A1) | (1 << WGM10);
    TCCR1B = (1 << WGM12) |
             (1 << CS11) |
             (1 << CS10);

    OCR1A = 0;
}

void fan_set(uint8_t porcentaje)
{
    if (porcentaje > 100)
        porcentaje = 100;

    OCR1A = ((uint16_t)porcentaje * 255) / 100;
    velocidad_ventilador = porcentaje;
}

void heater_on(void)
{
#if RELAY_ACTIVE_LOW
    PORTB &= ~(1 << HEATER);
#else
    PORTB |= (1 << HEATER);
#endif
    calefactor = 1;
}

void heater_off(void)
{
#if RELAY_ACTIVE_LOW
    PORTB |= (1 << HEATER);
#else
    PORTB &= ~(1 << HEATER);
#endif
    calefactor = 0;
}

void recalcular_rangos(void)
{
    rango_min = punto_medio - 6;
    rango_max = punto_medio + 6;
    fan_bajo_max = punto_medio + 17;
    fan_medio_max = punto_medio + 28;
}

void controlar_temperatura(float temperatura)
{
    if (temperatura < rango_min)
    {
        heater_on();
        fan_set(0);
        accion_actual = "CALEFACTOR";
    }
    else if (temperatura <= rango_max)
    {
        heater_off();
        fan_set(0);
        accion_actual = "RANGO IDEAL";
    }
    else if (temperatura <= fan_bajo_max)
    {
        heater_off();
        fan_set(35);
        accion_actual = "FAN BAJO";
    }
    else if (temperatura <= fan_medio_max)
    {
        heater_off();
        fan_set(65);
        accion_actual = "FAN MEDIO";
    }
    else
    {
        heater_off();
        fan_set(100);
        accion_actual = "FAN ALTO";
    }
}

int main(void)
{
    char buffer[100];
    float temperatura;

    PORTB |= (1 << HEATER);
    DDRB |= (1 << HEATER) | (1 << FAN_PWM);

    heater_off();
    uart_init();
    adc_init();
    pwm_init();
    recalcular_rangos();

    uart_print("Control de temperatura iniciado\r\n");

    while (1)
    {
        temperatura = leer_temperatura();
        controlar_temperatura(temperatura);

        int entero = (int)temperatura;
        int decimal = (int)((temperatura - entero) * 10);

        if (decimal < 0)
            decimal = -decimal;

        snprintf(buffer, sizeof(buffer),
                 "Temperatura: %d.%d C | Accion: %s\r\n",
                 entero, decimal, accion_actual);

        uart_print(buffer);

        _delay_ms(1000);
    }
}
