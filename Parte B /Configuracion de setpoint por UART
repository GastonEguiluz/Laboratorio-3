
#define F_CPU 16000000UL

#include <avr/io.h>
#include <util/delay.h>
#include <stdlib.h>
#include <stdint.h>

#define IN1 PD6
#define IN2 PD7

#define DEAD_BAND 20
#define POT_MIN 80
#define POT_MAX 940

uint16_t setpoint = 500;

void UART_init(void)
{
    UBRR0H = 0;
    UBRR0L = 103;

    UCSR0B = (1 << RXEN0) | (1 << TXEN0);
    UCSR0C = (1 << UCSZ01) | (1 << UCSZ00);
}

void UART_send_char(char c)
{
    while (!(UCSR0A & (1 << UDRE0)));
    UDR0 = c;
}

void UART_send_string(char *texto)
{
    while (*texto)
    {
        UART_send_char(*texto);
        texto++;
    }
}

void UART_send_number(uint16_t numero)
{
    char buffer[10];
    itoa(numero, buffer, 10);
    UART_send_string(buffer);
}

void ADC_init(void)
{
    ADMUX = (1 << REFS0);

    ADCSRA =
        (1 << ADEN) |
        (1 << ADPS2) |
        (1 << ADPS1) |
        (1 << ADPS0);
}

uint16_t ADC_read(uint8_t canal)
{
    ADMUX = (ADMUX & 0xF0) | canal;
    ADCSRA |= (1 << ADSC);

    while (ADCSRA & (1 << ADSC));

    return ADC;
}

void PWM_init(void)
{
    DDRB |= (1 << PB1);

    TCCR1A =
        (1 << COM1A1) |
        (1 << WGM10);

    TCCR1B =
        (1 << WGM12) |
        (1 << CS11) |
        (1 << CS10);

    OCR1A = 0;
}

void Motor_init(void)
{
    DDRD |= (1 << IN1) | (1 << IN2);
    PORTD &= ~((1 << IN1) | (1 << IN2));
}

void motor_parar(void)
{
    PORTD &= ~(1 << IN1);
    PORTD &= ~(1 << IN2);
    OCR1A = 0;
}

void motor_horario(uint8_t pwm)
{
    PORTD |= (1 << IN1);
    PORTD &= ~(1 << IN2);
    OCR1A = pwm;
}

void motor_antihorario(uint8_t pwm)
{
    PORTD &= ~(1 << IN1);
    PORTD |= (1 << IN2);
    OCR1A = pwm;
}

uint8_t calcular_PWM(uint16_t error)
{
    uint16_t pwm;

    pwm = 60 + error / 4;

    if (pwm > 255)
        pwm = 255;

    return (uint8_t)pwm;
}

void UART_leer_setpoint(void)
{
    static uint16_t numero = 0;
    static uint8_t recibiendo = 0;

    if (UCSR0A & (1 << RXC0))
    {
        char dato = UDR0;

        if (dato >= '0' && dato <= '9')
        {
            numero = numero * 10 + (dato - '0');
            recibiendo = 1;
        }

        if ((dato == '\n' || dato == '\r') && recibiendo)
        {
            if (numero > 1023)
                numero = 1023;

            setpoint = numero;

            UART_send_string("Nuevo setpoint: ");
            UART_send_number(setpoint);
            UART_send_string("\r\n");

            numero = 0;
            recibiendo = 0;
        }
    }
}

int main(void)
{
    uint16_t ldr;
    uint16_t posicion;
    int16_t error;
    uint16_t error_abs;
    uint8_t pwm;

    UART_init();
    ADC_init();
    PWM_init();
    Motor_init();

    UART_send_string("\r\nCONTROL DE ILUMINACION\r\n");
    UART_send_string("Enviar setpoint entre 0 y 1023\r\n");

    while (1)
    {
        UART_leer_setpoint();

        ldr = ADC_read(0);
        posicion = ADC_read(1);

        error = (int16_t)setpoint - (int16_t)ldr;

        if (error > DEAD_BAND)
        {
            error_abs = error;
            pwm = calcular_PWM(error_abs);

            if (posicion < POT_MAX)
            {
                motor_horario(pwm);
            }
            else
            {
                motor_parar();
                pwm = 0;
            }
        }
        else if (error < -DEAD_BAND)
        {
            error_abs = -error;
            pwm = calcular_PWM(error_abs);

            if (posicion > POT_MIN)
            {
                motor_antihorario(pwm);
            }
            else
            {
                motor_parar();
                pwm = 0;
            }
        }
        else
        {
            motor_parar();
            pwm = 0;
        }

        UART_send_string("Setpoint: ");
        UART_send_number(setpoint);

        UART_send_string(" | LDR: ");
        UART_send_number(ldr);

        UART_send_string(" | Posicion: ");
        UART_send_number(posicion);

        UART_send_string(" | PWM: ");
        UART_send_number(pwm);

        UART_send_string("\r\n");

        _delay_ms(200);
    }
}
