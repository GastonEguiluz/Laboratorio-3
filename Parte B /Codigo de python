import serial
import time
import matplotlib.pyplot as plt

puerto = "COM4"

arduino = serial.Serial(
    puerto,
    9600,
    timeout=1
)

time.sleep(2)

setpoint = input("Ingrese setpoint de iluminacion (0-1023): ")

arduino.write((setpoint + "\n").encode())

tiempo = []

datos_setpoint = []
datos_ldr = []
datos_posicion = []
datos_pwm = []

inicio = time.time()

plt.ion()

fig, ax = plt.subplots()

linea_setpoint, = ax.plot([], [], label="Setpoint")
linea_ldr, = ax.plot([], [], label="LDR")
linea_posicion, = ax.plot([], [], label="Posicion")
linea_pwm, = ax.plot([], [], label="PWM")

ax.set_xlabel("Tiempo (s)")
ax.set_ylabel("Valor")

ax.legend()

while True:

    try:

        linea = arduino.readline().decode(errors="ignore").strip()

        if linea.startswith("DATA"):

            partes = linea.split(",")

            if len(partes) == 6:

                sp = int(partes[1])

                ldr = int(partes[2])

                posicion = int(partes[3])

                pwm = int(partes[4])

                direccion = partes[5]

                t = time.time() - inicio

                tiempo.append(t)

                datos_setpoint.append(sp)

                datos_ldr.append(ldr)

                datos_posicion.append(posicion)

                datos_pwm.append(pwm)

                print(
                    "SP:", sp,
                    "LDR:", ldr,
                    "POS:", posicion,
                    "PWM:", pwm,
                    "DIR:", direccion
                )

                linea_setpoint.set_data(tiempo, datos_setpoint)

                linea_ldr.set_data(tiempo, datos_ldr)

                linea_posicion.set_data(tiempo, datos_posicion)

                linea_pwm.set_data(tiempo, datos_pwm)

                ax.relim()

                ax.autoscale_view()

                plt.pause(0.01)

    except KeyboardInterrupt:

        break

arduino.close()

plt.ioff()

plt.show()
